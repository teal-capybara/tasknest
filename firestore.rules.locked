rules_version = '2';

// ============================================================================
// LOCKED RULES (use after Part C of the README)
//
// Replace PASTE_YOUR_ACCOUNT_ID_HERE with the Account ID shown in the app's
// Account card (keep the quotes). Then paste the whole file into
// Firebase console > Firestore Database > Rules and press Publish.
//
// Result: only YOUR Google account can read or write anything. Even if a
// stranger signs in with their own Google account, they are refused.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == "PASTE_YOUR_ACCOUNT_ID_HERE";
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == userId;
    }
  }
}
